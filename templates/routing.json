{
  "_doc": "复制到 ~/.config/herdr-mattpocock-skills/routing.json（或项目 .agents/herdr/routing.json）后修改。tools 定义各 CLI 的启动模板与参数映射；roles 定义每个身份用哪个工具、模型、思考等级、载体。model/effort 填 default 表示工具默认值。占位符：{model}/{effort} 展开为该工具的参数（值为 default 时省略），{prompt} 为派工指令，{sessionId} 为预先生成的 UUID，{patch} 为补丁文件参数。工具没有 model/effort 映射时，对应身份只能用 default。",
  "schemaVersion": 2,
  "defaultMode": "simple",
  "docsDir": ".agents/herdr/session",
  "runDir": ".agents/herdr/run",
  "tools": {
    "codex": {
      "interactive": ["codex", "{model}", "{effort}"],
      "headless": ["codex", "exec", "--ephemeral", "--skip-git-repo-check", "--sandbox", "workspace-write", "{model}", "{effort}", "{prompt}"],
      "model": ["--model", "{value}"],
      "effort": ["-c", "model_reasoning_effort=\"{value}\""]
    },
    "claude-code": {
      "interactive": ["claude", "--session-id", "{sessionId}", "{model}", "{effort}"],
      "headless": ["claude", "-p", "--no-session-persistence", "{model}", "{effort}", "{prompt}"],
      "model": ["--model", "{value}"],
      "effort": ["--effort", "{value}"]
    },
    "cursor": {
      "interactive": ["agent", "{model}"],
      "headless": ["agent", "-p", "{model}", "{prompt}"],
      "model": ["--model", "{value}"]
    },
    "gemini": {
      "interactive": ["gemini", "{model}"],
      "headless": ["gemini", "{model}", "-p", "{prompt}"],
      "model": ["-m", "{value}"]
    },
    "dsh": {
      "interactive": ["dsh", "--profile", "tui", "{patch}"],
      "headless": ["dsh", "--profile", "headless", "{patch}", "{prompt}"],
      "patch": {
        "flag": "--patch",
        "template": "- id: agent-default-model\n  config:\n    provider: {provider}\n    model: {modelId}\n    reasoningEffort: {effortValue}\n"
      },
      "_doc": "DSH 的模型通过补丁覆盖，model 写成 provider/model；值为 default 的行会被省略。"
    }
  },
  "roles": {
    "secretary": { "tool": "current", "model": "inherit", "effort": "inherit", "carrier": "current" },
    "griller": { "tool": "codex", "model": "default", "effort": "default", "carrier": "herdr", "place": "split" },
    "pm": { "tool": "codex", "model": "default", "effort": "default", "carrier": "herdr", "place": "tab" },
    "frontend": { "tool": "claude-code", "model": "default", "effort": "default", "carrier": "herdr", "place": "tab" },
    "backend": { "tool": "codex", "model": "default", "effort": "default", "carrier": "herdr", "place": "tab" },
    "searcher": { "tool": "codex", "model": "default", "effort": "default", "carrier": "background" },
    "reviewer": { "tool": "claude-code", "model": "default", "effort": "default", "carrier": "background" },
    "checker": { "tool": "dsh", "model": "default", "effort": "default", "carrier": "background" },
    "merger": { "inherit": "pm", "carrier": "background" },
    "designer": { "inherit": "griller", "carrier": "background" }
  },
  "simple": {
    "main": ["secretary", "pm", "backend"]
  }
}
